APP_ENV=dev
HTTP_ADDR=:8080

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_IDS=
# Optional separate administrator Bot. Leave empty to use only the user Bot + /admin.
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_WEBHOOK_URL=
ADMIN_TELEGRAM_WEBHOOK_SECRET=

# Web admin (Redis session login; put admin behind VPN/SSO in production)
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=CHANGE_ME_NOW

# MariaDB
MYSQL_DSN=bot:bot_password@tcp(127.0.0.1:3306)/telegram_bot?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
# docker-compose only: database passwords (used when the MariaDB volume is first created)
DB_PASSWORD=bot_password
DB_ROOT_PASSWORD=root_password
REDIS_DB=0
SESSION_TTL_MINUTES=30

# Wallet defaults
WALLET_CURRENCY=USDT
WITHDRAW_MIN_USDT=1
WITHDRAW_FEE_USDT=1
REFERRAL_RATE=0.005

# TRON / TronGrid
# mainnet: https://api.trongrid.io
# shasta:  https://api.shasta.trongrid.io
TRONGRID_BASE_URL=https://api.shasta.trongrid.io
TRONGRID_API_KEY=
# Official USDT mainnet contract is NOT prefilled intentionally. Configure the network/contract you actually use.
TRON_USDT_CONTRACT=
TRON_CONFIRM_ONLY=true
TRON_WATCH_ENABLED=false
TRON_WATCH_INTERVAL_SECONDS=30

# Legacy setting (no longer displayed): shared fallback addresses cannot identify the depositor.
# Allocate/bind a unique address per user via the admin address page.
TRON_FALLBACK_DEPOSIT_ADDRESS=

# Public address of the admin console, sent to approved merchants with their login (optional).
ADMIN_PUBLIC_URL=

# Optional split listeners: set all four *_HTTP_ADDR (and the public URLs) or none. Then
#   HTTP_ADDR           Telegram webhooks, console file uploads and /uploads only
#   OPERATOR_HTTP_ADDR  operator console pages (/admin/), platform accounts only
#   MERCHANT_HTTP_ADDR  merchant console pages (/admin/), merchant and staff accounts only
#   SHOP_HTTP_ADDR      H5 shop page (/shop/)
#   API_HTTP_ADDR       every console and shop API (/admin/api/*, /shop/api/*, sign-in)
# Every listener serves /healthz. The *_PUBLIC_URL values are the addresses browsers use: pages
# call the API at API_PUBLIC_URL, which only answers the console origins, the SHOP_H5_URL origin
# and API_ALLOWED_ORIGINS. The consoles and the API must share one site (e.g. ops.example.com,
# seller.example.com and api.example.com) so the session cookie works. MAIN_PUBLIC_URL is the
# public address of HTTP_ADDR (defaults to UPLOAD_PUBLIC_BASE_URL without /uploads).
API_HTTP_ADDR=
OPERATOR_HTTP_ADDR=
MERCHANT_HTTP_ADDR=
SHOP_HTTP_ADDR=
API_PUBLIC_URL=
OPERATOR_PUBLIC_URL=
MERCHANT_PUBLIC_URL=
MAIN_PUBLIC_URL=
API_ALLOWED_ORIGINS=

# Optional self-hosted Telegram Bot API server (https://github.com/tdlib/telegram-bot-api).
TELEGRAM_API_URL=

# H5 shop opened by the menu button left of the input field (user and business bots).
# The built-in shop is served at /shop/ by this program, e.g. https://bot.example.com/shop/
# Must be https. Leave empty to keep the command list button.
SHOP_H5_URL=
SHOP_H5_BUTTON_TEXT=商城

# Daily database backups (gzip SQL). Empty BACKUP_DIR disables them; keep the newest BACKUP_KEEP.
# Restore: gunzip -c backup-YYYYMMDD-HHMMSS.sql.gz | mysql -u USER -p DBNAME
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_HOUR=3

# Log files (rotated, gzip-compressed). Default ./logs; set LOG_DIR=off to log to console only.
LOG_DIR=./logs
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE_DAYS=30

# Uploaded files (public URL must be reachable by Telegram)
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=https://bot.example.com/uploads
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=50

# Optional stable encryption key for additional business-bot tokens.
# Set once (32+ random characters) before adding bots. When empty, the primary bot token is used.
# Changing this key requires re-entering saved business-bot tokens.
BUSINESS_BOT_KEY=
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated CIDRs). Empty or "none" =
# trust nobody (the connection's address is the client's). Behind nginx on this host use
# 127.0.0.1; behind a CDN use its published ranges; "private" trusts all private networks.
TRUSTED_PROXIES=
